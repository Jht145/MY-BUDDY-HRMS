# NEXT.JS FRONTEND CONFIGURATION
NEXT_PUBLIC_APP_NAME="MY BUDDY HRMS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_AUTH_SIGNIN_ENDPOINT="/auth/login"
NEXT_PUBLIC_AUTH_SIGNUP_ENDPOINT="/auth/register"
NEXT_PUBLIC_AUTH_ME_ENDPOINT="/auth/me"

# GEOFENCING CONFIG
NEXT_PUBLIC_OFFICE_LAT=12.9716
NEXT_PUBLIC_OFFICE_LNG=77.5946
NEXT_PUBLIC_GEOFENCE_RADIUS_METERS=100

# BACKEND SERVER CONFIGURATION
PORT=5000
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h
NODE_ENV=development
